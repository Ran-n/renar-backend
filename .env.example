# Copy to .env and change values

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/xoutaim
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:8550","http://127.0.0.1:8550"]
# Root of the content-addressed file store (avatars, cached posters/covers)
MEDIA_DIR=./media

# --- External APIs ---
# Free key from https://www.themoviedb.org/settings/api (v3 key or v4 read token both work)
TMDB_API_KEY=
# Optional. Improves TV Time import matching: when TMDB can't map a TVDB id
# directly, we ask TheTVDB for the show's name/aliases and retry on TMDB by
# title. Free v4 key from https://thetvdb.com/api-information
TVDB_API_KEY=
# How long (hours) persisted TMDB payloads for tracked titles are served
# without re-contacting TMDB (stale copies still serve during TMDB outages)
TMDB_DB_CACHE_HOURS=24
# Optional. Powers channel search + video listing on the Explore YouTube tab.
# Free key from https://console.cloud.google.com/apis/credentials (enable
# "YouTube Data API v3" on the project first). Without it the tab is disabled.
YOUTUBE_API_KEY=

# --- Admin panel ---
# Where the panel lives. Rename it to something unguessable (e.g. /panel-x7k2)
# and the default /admin automatically becomes a honeypot.
ADMIN_PATH=/admin
# HTTP Basic credentials; the panel returns 503 until both are set
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Frontend anti-abuse sharing ---
# Shared secret for /svc/bans, which lets the xoutaim-frontend web server's
# own anti-abuse guard read/add to this server's banned_ips table. Empty
# means those endpoints stay 404 to everyone. Must match XOUTAIM_INTERNAL_SECRET
# in the frontend's .env.
INTERNAL_SERVICE_SECRET=

# --- Anti-abuse (defaults shown; all optional) ---
# Rate limiting, honeypot traps, and automatic temporary bans for scanners.
# Limits are per IP; one IP can be a whole office or mobile-carrier NAT pool,
# so normal responses are throttles (429 + Retry-After) and bans are reserved
# for behavior no legitimate client exhibits (honeypots, unknown-path probing).
# Honeypot hits (/.env, /wp-login.php, /internal/, ...) are PERMANENT bans,
# stored in the banned_ips table; review/lift them at <ADMIN_PATH>/bans.
# Boot-time only: gates whether the guard middleware is installed on the app
# at all. Unlike everything else in this section, this can't be flipped from
# the admin panel — changing it means an .env edit + restart.
ABUSE_GUARD_ENABLED=true
# Serve /docs + /openapi.json (off in production: they map the whole API for scanners)
ENABLE_DOCS=false
# Seed default only, used on first run and as a fallback if the DB is
# unreachable — after that, <ADMIN_PATH>/settings owns the live value, no
# restart or .env edit needed. Set true ONLY when running behind a reverse
# proxy/CDN (nginx, Caddy, Cloudflare): reads the real client IP from
# X-Forwarded-For. Without a proxy this header is client-controlled — leave
# false, and don't flip it on in the admin panel unless a proxy really is there.
TRUST_PROXY_HEADERS=false
# Seed default only (see above): IPs never rate-limited (monitoring, local
# tooling). Edit the live list from <ADMIN_PATH>/settings.
EXEMPT_IPS=["127.0.0.1","::1"]
# Registration mode (open/invite-only), rate limits, login backoff, probe/ban
# thresholds, proxy trust, and exempt IPs are no longer configured here — they
# live in the site_settings DB row (seeded with sensible defaults on first
# run) and are edited live from <ADMIN_PATH>/settings, no restart or .env
# edit needed.
