# Copy to .env and change values

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./xoutaim.db
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:8550","http://127.0.0.1:8550"]
# Root of the content-addressed file store (avatars, cached posters/covers)
MEDIA_DIR=./media

# --- External APIs ---
# Free key from https://www.themoviedb.org/settings/api (v3 key or v4 read token both work)
TMDB_API_KEY=
# Optional. Improves TV Time import matching: when TMDB can't map a TVDB id
# directly, we ask TheTVDB for the show's name/aliases and retry on TMDB by
# title. Free v4 key from https://thetvdb.com/api-information
TVDB_API_KEY=
# How often (minutes) to check TMDB for new episodes of tracked shows
EPISODE_CHECK_MINUTES=360

# --- Admin panel ---
# Where the panel lives. Rename it to something unguessable (e.g. /panel-x7k2)
# and the default /admin automatically becomes a honeypot.
ADMIN_PATH=/admin
# HTTP Basic credentials; the panel returns 503 until both are set
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Anti-abuse (defaults shown; all optional) ---
# Rate limiting, honeypot traps, and automatic temporary bans for scanners.
# Limits are per IP; one IP can be a whole office or mobile-carrier NAT pool,
# so normal responses are throttles (429 + Retry-After) and bans are reserved
# for behavior no legitimate client exhibits (honeypots, unknown-path probing).
# Honeypot hits (/.env, /wp-login.php, /internal/, ...) are PERMANENT bans,
# stored in the banned_ips table; review/lift them at <ADMIN_PATH>/bans.
ABUSE_GUARD_ENABLED=true
# Serve /docs + /openapi.json (off in production: they map the whole API for scanners)
ENABLE_DOCS=false
# Set false to stop new signups
REGISTRATION_OPEN=true
# Set true ONLY when running behind a reverse proxy/CDN (nginx, Caddy,
# Cloudflare): reads the real client IP from X-Forwarded-For. Without a proxy
# this header is client-controlled — leave false.
TRUST_PROXY_HEADERS=false
# IPs never rate-limited (monitoring, local tooling)
EXEMPT_IPS=["127.0.0.1","::1"]
# Soft per-IP ceiling: over it = 429 throttle, never a ban
RATE_LIMIT_PER_MINUTE=600
# Unambiguous flood: temporary ban (doubles for repeat offenders, capped at 24h)
FLOOD_BAN_PER_MINUTE=2000
# Login/register requests per IP per minute (throttle only)
AUTH_RATE_LIMIT_PER_MINUTE=30
# New accounts per IP per hour (throttle only)
REGISTER_PER_HOUR_PER_IP=20
# Failed logins per (account, IP) / per account across all IPs before that
# account gets a cool-down (protects against brute force + credential stuffing
# without locking out offices that share an IP)
LOGIN_BACKOFF_THRESHOLD=5
LOGIN_BACKOFF_ACCOUNT_THRESHOLD=30
LOGIN_BACKOFF_MINUTES=15
# Requests to paths that match no route at all (scanner mapping) before a
# temporary ban; 404s on real endpoints and requests carrying a valid session
# token never count
PROBE_BAN_THRESHOLD=12
PROBE_WINDOW_MINUTES=10
BAN_MINUTES=60
# Persisted offenses (see the strikes table) before a temporary ban
# escalates into a permanent one; streak resets after 24h with no new offense
STRIKE_BAN_THRESHOLD=5
