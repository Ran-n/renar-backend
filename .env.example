# Copy to .env and change values
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./xoutaim.db
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:8550","http://127.0.0.1:8550"]
# Free key from https://www.themoviedb.org/settings/api (v3 key or v4 read token both work)
TMDB_API_KEY=
# How often (minutes) to check TMDB for new episodes of tracked shows
EPISODE_CHECK_MINUTES=360
