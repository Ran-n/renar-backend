# Copy to .env and change values

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/renar
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:8550","http://127.0.0.1:8550"]
# Root of the content-addressed file store (avatars, cached posters/covers)
MEDIA_DIR=./media

# --- External APIs ---
# Free key from https://www.themoviedb.org/settings/api (v3 key or v4 read token both work)
TMDB_API_KEY=
# Optional. Improves TV Time import matching: when TMDB can't map a TVDB id
# directly, we ask TheTVDB for the show's name/aliases and retry on TMDB by
# title. Free v4 key from https://thetvdb.com/api-information
TVDB_API_KEY=
# Cloudflare Turnstile on /auth/register — free at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both empty to skip the check entirely (dev default). The on/off
# switch itself lives on the admin Site Settings page, not here — same as
# Registration open / Invite only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Brevo (https://www.brevo.com) transactional email, for registration/email-
# change confirmation codes. Empty key means the code is logged instead of
# sent — safe to leave unset until a verified sending domain is ready.
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=noreply@renar.breren.com

# --- Admin panel ---
# Where the panel lives. Rename it to something unguessable (e.g. /panel-x7k2)
# and the default /admin automatically becomes a honeypot.
ADMIN_PATH=/admin
# HTTP Basic credentials; the panel returns 503 until both are set
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Frontend anti-abuse sharing ---
# Shared secret for /svc/bans, which lets the renar-frontend web server's
# own anti-abuse guard read/add to this server's banned_ips table. Empty
# means those endpoints stay 404 to everyone. Must match RENAR_INTERNAL_SECRET
# in the frontend's .env.
INTERNAL_SERVICE_SECRET=

# --- Anti-abuse (defaults shown; all optional; see docs/anti-abuse.md) ---
# Master switch, boot-time only — can't be flipped from the admin panel.
RENAR_ABUSE_GUARD_ENABLED=true
# Off in production: /docs + /openapi.json map the whole API for scanners.
ENABLE_DOCS=false
